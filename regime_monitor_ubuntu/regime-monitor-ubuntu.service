[Unit]
Description=Ubuntu Regime Monitor Flask Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=REGIME_MONITOR_URL=http://example.local:8080/regime.json
ExecStart=/usr/bin/python3 /opt/regime-monitor-ubuntu/regime_monitor.py --config /etc/regime-monitor/config.json --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

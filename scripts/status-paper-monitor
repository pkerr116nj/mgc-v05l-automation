#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common_env.sh"

PID_FILE="${REPO_ROOT}/var/paper_strategy_monitor_service.pid"
"${PYTHON_BIN}" - <<'PY' "${REPO_ROOT}"
import json
import sys
from pathlib import Path

from mgc_v05l.execution.ibkr_paper_strategy_monitor import (
    build_paper_strategy_monitor_service_status,
    write_paper_strategy_monitor_service_status_artifacts,
)

repo_root = Path(sys.argv[1])
report = build_paper_strategy_monitor_service_status(repo_root=repo_root)
write_paper_strategy_monitor_service_status_artifacts(repo_root=repo_root, report=report)
print(json.dumps(report, indent=2, sort_keys=True))
PY

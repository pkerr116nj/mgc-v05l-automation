#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common_env.sh"

PID_FILE="${REPO_ROOT}/var/phase1_databento_live_candles_service.pid"
CHILD_PID_FILE="${REPO_ROOT}/var/phase1_databento_live_candles_child.pid"

if [[ ! -f "${PID_FILE}" ]]; then
  echo "No Phase-1 Databento live candle service PID file found."
  exit 0
fi

service_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
if [[ -z "${service_pid}" ]]; then
  rm -f "${PID_FILE}"
  echo "Removed empty Phase-1 Databento live candle service PID file."
  exit 0
fi

if kill -0 "${service_pid}" 2>/dev/null; then
  kill "${service_pid}"
  echo "Stopped Phase-1 Databento live candle supervisor pid ${service_pid}."
else
  echo "Phase-1 Databento live candle supervisor pid ${service_pid} was not running."
fi

if [[ -f "${CHILD_PID_FILE}" ]]; then
  child_pid="$(cat "${CHILD_PID_FILE}" 2>/dev/null || true)"
  if [[ -n "${child_pid}" ]] && kill -0 "${child_pid}" 2>/dev/null; then
    kill "${child_pid}"
    echo "Stopped Phase-1 Databento live candle child pid ${child_pid}."
  fi
fi
rm -f "${PID_FILE}"
rm -f "${CHILD_PID_FILE}"

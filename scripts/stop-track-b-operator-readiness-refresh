#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common_env.sh"

PID_FILE="${REPO_ROOT}/var/track_b_operator_readiness_refresh_service.pid"

if [[ ! -f "${PID_FILE}" ]]; then
  echo "Track B operator readiness refresh service is not running."
  exit 0
fi

service_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
if [[ -n "${service_pid}" ]] && kill -0 "${service_pid}" 2>/dev/null; then
  kill -TERM "${service_pid}" 2>/dev/null || true
  for _ in {1..20}; do
    if ! kill -0 "${service_pid}" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  if kill -0 "${service_pid}" 2>/dev/null; then
    echo "Track B operator readiness refresh service pid ${service_pid} did not stop cleanly within 20s." >&2
    exit 1
  fi
  echo "Stopped Track B operator readiness refresh service pid ${service_pid}."
else
  echo "Track B operator readiness refresh pid file exists, but the process is not running."
fi
rm -f "${PID_FILE}"

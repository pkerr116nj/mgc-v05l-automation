#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common_env.sh"

PID_FILE="${REPO_ROOT}/var/track_b_operator_readiness_refresh_service.pid"
CHILD_PID_FILE="${REPO_ROOT}/var/track_b_operator_readiness_refresh_child.pid"

pid_is_running() {
  local pid="$1"
  [[ -n "${pid}" ]] || return 1
  "${PYTHON_BIN}" - "${pid}" <<'PYPID'
import os
import sys
try:
    os.kill(int(sys.argv[1]), 0)
except ProcessLookupError:
    raise SystemExit(1)
except PermissionError:
    raise SystemExit(0)
except Exception:
    raise SystemExit(1)
raise SystemExit(0)
PYPID
}

read_pid_file() {
  local path="$1"
  [[ -f "${path}" ]] || return 1
  tr -d '[:space:]' < "${path}" 2>/dev/null
}

stop_pid() {
  local label="$1"
  local pid="$2"
  [[ -n "${pid}" ]] || return 0
  if ! pid_is_running "${pid}"; then
    return 0
  fi
  kill -TERM "${pid}" 2>/dev/null || true
  for _ in {1..20}; do
    if ! pid_is_running "${pid}"; then
      echo "Stopped Track B operator readiness refresh ${label} pid ${pid}."
      return 0
    fi
    sleep 1
  done
  echo "Track B operator readiness refresh ${label} pid ${pid} did not stop cleanly within 20s." >&2
  return 1
}

service_pid="$(read_pid_file "${PID_FILE}" || true)"
child_pid="$(read_pid_file "${CHILD_PID_FILE}" || true)"

if [[ -z "${service_pid}" && -z "${child_pid}" ]]; then
  echo "Track B operator readiness refresh service is not running."
  exit 0
fi

stop_pid "supervisor" "${service_pid}"
stop_pid "child" "${child_pid}"
rm -f "${PID_FILE}" "${CHILD_PID_FILE}"

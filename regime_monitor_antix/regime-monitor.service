[Unit]
Description=Fullscreen Regime Monitor
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=REGIME_MONITOR_URL=http://example.local:8080/regime.json
Environment=REGIME_MONITOR_HOST=127.0.0.1
Environment=REGIME_MONITOR_PORT=8765
ExecStart=/opt/regime-monitor/start-regime-monitor.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
